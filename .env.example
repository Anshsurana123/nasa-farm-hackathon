# Copy to .env and fill in. Never commit .env.

# Google Earth Engine (primary NASA data access path). Create a Cloud project with EE API enabled.
GEE_PROJECT=

# NASA Earthdata login (for earthaccess / AppEEARS: SMAP L4, GRACE-FO, ECOSTRESS)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Optional overrides
TERRALOOP_CACHE_DIR=
TERRALOOP_CROP_KB=

# LLM explainer (TASK-X02)
LLM_API_KEY=

# Frontend -> API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
