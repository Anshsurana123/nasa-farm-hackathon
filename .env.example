# Copy to .env and fill in. Never commit .env.

# Google Earth Engine (primary NASA data access path).
# Locally: set GEE_PROJECT and run `earthengine authenticate`.
# On Vercel / serverless: create a GCP Service Account, enable EE API, grant Earth Engine Viewer role,
# and provide GEE_SERVICE_ACCOUNT_KEY (the JSON string or base64-encoded JSON of the key).
GEE_PROJECT=
GEE_SERVICE_ACCOUNT_KEY=

# NASA Earthdata login (for earthaccess / AppEEARS: SMAP L4, GRACE-FO, ECOSTRESS)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Meteomatics 90m Weather, Soil Hydrology & CMIP6 Sponsor API
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=
METEOMATICS_BASE_URL=https://api.meteomatics.com

# Optional overrides
TERRALOOP_CACHE_DIR=
TERRALOOP_CROP_KB=

# LLM explainer (TASK-X02)
GEMINI_API_KEY=
LLM_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_MODEL=gemini-3.8-flash

# Frontend -> API base URL. Leave UNSET on Vercel / `vercel dev` (defaults to same-origin /api).
# Set to http://localhost:8000 only when running `npm run dev` standalone against a local uvicorn.
NEXT_PUBLIC_API_URL=
